# Database
DATABASE_URL="file:./dev.db"

# Mistral AI API (leave empty for mock mode)
MISTRAL_API_KEY=

# JWT Secret for admin auth
JWT_SECRET=change-this-to-a-random-secret

# Server port
PORT=3001

# Discovery source: hackernews | arxiv | rss
DISCOVERY_SOURCE=hackernews

# Autonomous schedule intervals (minutes)
CRON_INTERVAL_MIN=60
CRON_INTERVAL_MAX=240
