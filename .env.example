# ── Autonomous AI Creator ── Environment Variables ──

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_creator

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JWT Secret for admin auth
JWT_SECRET=change-this-to-a-random-secret

# Server
PORT=3001

# Discovery source: hackernews | arxiv | rss
DISCOVERY_SOURCE=hackernews

# Autonomous schedule intervals (minutes)
CRON_INTERVAL_MIN=60
CRON_INTERVAL_MAX=240

# Frontend
VITE_API_URL=http://localhost:3001
